# Local sorting folders (DO NOT COMMIT - personal/machine-specific content)
__НА_УДАЛЕНИЕ/
__СОХРАНИТЬ_ЛОКАЛЬНО/

# Code backups (never commit)
*.bak
*.bak_*
*.bak*
*goodbak*
*mojifix*
*_backup_*
backup_*/
backup_*
_backup_*/
__НА_УДАЛЕНИЕ/
__СОХРАНИТЬ_ЛОКАЛЬНО/
__MUSLY_*/

# Android signing secrets (NEVER COMMIT - real keystore lives only in CI secrets)
*.jks
*.keystore
*.p12
*.pfx
key.properties
!/android/key.properties.example
android/local.properties
local.properties

# Environment with real keys (template .env.example is OK to commit)
.env
.env.local

# Flutter generated / ephemeral (regenerated by `flutter pub get` / build)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.flutter_upgrade_check
build/
**/flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
ios/Flutter/AppFrameworkInfo.plist
.macos/
linux/flutter/generated_plugin_registrant.*
windows/flutter/generated_plugin_registrant.*
.pub-cache/
.pub/
/coverage/

# Gradle caches / JVM crash logs
.gradle/
.kotlin/
cxx/
hs_err_pid*.log
replay_pid*.log

# Misc local junk
l10n_untranslated.json
analysis_report.txt
test_server_config.json
kumaflow-1.0.4-setup.exe
/discord_sdk_temp
migrate_working_dir/
.claude/
__pycache__/
.venv/

# Release artifacts live in GitHub Releases, not in git
*.apk
*.aab
*.zip
*.exe
*.msi
installer*.log
build*.log
build_*.log
analyze*.log
analyze_*.log
installed-old.apk
flutter_build*.log
build.log
build_last.log
build_release*.log

# Session notes / local plans (personal working notes)
SESSION_*.md
SESSION_CONTINUE_*.md
SESSION_PLAN.md

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
