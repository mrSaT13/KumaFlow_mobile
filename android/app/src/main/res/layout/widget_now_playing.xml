<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Top row: cover art + track info + progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Cover Art - увеличена с 60dp до 72dp для лучшей видимости -->
        <ImageView
            android:id="@+id/widget_cover_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_cover"
            android:padding="2dp"
            android:src="@drawable/ic_widget_default_cover"
            android:contentDescription="@string/widget_cover_art" />

        <!-- Track Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Track"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#B3FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif" />

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="#FFFA243C"
                android:progressBackgroundTint="#40FFFFFF" />

            <!-- Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/widget_current_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textSize="10sp"
                    android:textColor="#B3FFFFFF"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/widget_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textSize="10sp"
                    android:textColor="#B3FFFFFF"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Controls row: dislike / prev / play-pause / next / like -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/widget_dislike"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/widget_button_dislike_heart"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_dislike"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_previous"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_previous"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_widget_play"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_play_pause"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_next"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/widget_like"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/widget_button_like"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_like"
            android:scaleType="centerInside" />
    </LinearLayout>

</LinearLayout>
