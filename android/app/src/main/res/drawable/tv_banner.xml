<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback banner 320x180dp — required for Android TV launcher visibility.
     Uses app icon centered on dark gradient placeholder. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A0A2E"
                android:endColor="#6C1350"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
