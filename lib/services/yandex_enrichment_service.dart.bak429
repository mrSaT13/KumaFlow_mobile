import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:shared_preferences/shared_preferences.dart';
import '../models/song.dart';
import 'yandex_music_public_api.dart';

/// Cached enriched meta for a song/artist.
class EnrichedMeta {
  final String? genre;
  final List<String> yandexGenres;
  final List<String> similarArtists;
  final String? mood;
  final DateTime cachedAt;

  EnrichedMeta({
    this.genre,
    this.yandexGenres = const [],
    this.similarArtists = const [],
    this.mood,
    DateTime? cachedAt,
  }) : cachedAt = cachedAt ?? DateTime.now();

  Map<String, dynamic> toJson() => {
        'genre': genre,
        'yandexGenres': yandexGenres,
        'similarArtists': similarArtists,
        'mood': mood,
        'cachedAt': cachedAt.toIso8601String(),
      };

  factory EnrichedMeta.fromJson(Map<String, dynamic> j) => EnrichedMeta(
        genre: j['genre'] as String?,
        yandexGenres: List<String>.from(j['yandexGenres'] ?? []),
        similarArtists: List<String>.from(j['similarArtists'] ?? []),
        mood: j['mood'] as String?,
        cachedAt: j['cachedAt'] != null ? DateTime.tryParse(j['cachedAt']) ?? DateTime.now() : DateTime.now(),
      );

  bool get isExpired => DateTime.now().difference(cachedAt).inDays > 30;
}

/// Service for enriching local library with Yandex Music public data.
/// Works WITHOUT token — uses YandexMusicPublicApi (search, brief-info, similar).
/// Results are cached in SharedPreferences + memory to avoid hammering API.
class YandexEnrichmentService {
  static final YandexEnrichmentService _instance = YandexEnrichmentService._internal();
  factory YandexEnrichmentService() => _instance;
  YandexEnrichmentService._internal();

  final YandexMusicPublicApi _api = YandexMusicPublicApi();
  final Map<String, EnrichedMeta> _memory = {};
  static const _kCacheKey = 'yandex_enrich_cache_v1';
  static const _kCacheLimit = 800;
  bool _loaded = false;

  Future<void> _ensureLoaded() async {
    if (_loaded) return;
    try {
      final prefs = await SharedPreferences.getInstance();
      final raw = prefs.getString(_kCacheKey);
      if (raw != null) {
        final map = json.decode(raw) as Map<String, dynamic>;
        for (final e in map.entries) {
          try {
            final m = EnrichedMeta.fromJson(e.value);
            if (!m.isExpired) _memory[e.key] = m;
          } catch (_) {}
        }
      }
    } catch (e) {
      debugPrint('[Enrich] load cache error: $e');
    }
    _loaded = true;
  }

  Future<void> _persist() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      // Trim oldest if over limit
      if (_memory.length > _kCacheLimit) {
        final sorted = _memory.entries.toList()
          ..sort((a, b) => a.value.cachedAt.compareTo(b.value.cachedAt));
        final toRemove = _memory.length - _kCacheLimit;
        for (var i = 0; i < toRemove; i++) _memory.remove(sorted[i].key);
      }
      final map = _memory.map((k, v) => MapEntry(k, v.toJson()));
      await prefs.setString(_kCacheKey, json.encode(map));
    } catch (e) {
      debugPrint('[Enrich] persist error: $e');
    }
  }

  String _songKey(Song s) => '${s.artist ?? ''}::${s.title}::${s.artistId ?? ''}'.toLowerCase();
  String _artistKey(String artistName) => 'artist::${artistName.toLowerCase()}';

  EnrichedMeta? getCachedForSong(Song s) {
    final k = _songKey(s);
    final v = _memory[k];
    if (v != null && !v.isExpired) return v;
    return null;
  }

  EnrichedMeta? getCachedForArtist(String artistName) {
    final k = _artistKey(artistName);
    final v = _memory[k];
    if (v != null && !v.isExpired) return v;
    return null;
  }

  /// Enrich single song — returns genre + similar artists via public API.
  Future<EnrichedMeta?> enrichSong(Song song) async {
    await _ensureLoaded();
    final key = _songKey(song);
    final cached = _memory[key];
    if (cached != null && !cached.isExpired) return cached;

    try {
      // 1) Search tracks for this song
      final query = '${song.title} ${song.artist ?? ''}'.trim();
      final tracks = await _api.searchTracks(query, limit: 3);
      String? genre;
      List<String> yGenres = [];
      List<String> similar = [];
      String? yandexArtistId;

      if (tracks.isNotEmpty) {
        final first = tracks.first;
        genre = first['genre'] as String? ?? (first['albums'] as List?)?.firstOrNull?['genre'] as String?;
        // genres array
        final gList = first['genres'] as List?;
        if (gList != null) yGenres = gList.map((e) => e is String ? e : e['name']?.toString() ?? '').where((e) => e.isNotEmpty).toList();
        // Try to get yandex artist id for similar lookup
        yandexArtistId = _api.extractArtistId(first);
        if (yandexArtistId == null) {
          final artists = first['artists'] as List?;
          yandexArtistId = artists?.firstOrNull?['id']?.toString();
        }
      }

      // 2) Fallback: search artist -> brief-info for genres + similar
      if ((genre == null || yGenres.isEmpty) && song.artist != null) {
        final aKey = _artistKey(song.artist!);
        final aCached = _memory[aKey];
        if (aCached != null && !aCached.isExpired) {
          genre ??= aCached.genre;
          yGenres = yGenres.isEmpty ? aCached.yandexGenres : yGenres;
          similar = aCached.similarArtists;
        } else {
          final artists = await _api.searchArtists(song.artist!, limit: 1);
          if (artists.isNotEmpty) {
            final a = artists.first;
            final g = a['genres'] as List?;
            if (g != null) yGenres = g.map((e) => e is String ? e : e['name']?.toString() ?? '').where((e) => e.isNotEmpty).toList();
            genre ??= yGenres.isNotEmpty ? yGenres.first : null;
            final id = a['id']?.toString();
            if (id != null) {
              yandexArtistId ??= id;
              final similarRaw = await _api.getSimilarArtists(id, limit: 6);
              similar = similarRaw.map((e) => e['name']?.toString() ?? '').where((e) => e.isNotEmpty).toList();
              _memory[aKey] = EnrichedMeta(genre: genre, yandexGenres: yGenres, similarArtists: similar);
            }
          }
        }
      }

      // 3) Fetch similar via track similar endpoint if we have yandexArtistId fallback
      if (similar.isEmpty && yandexArtistId != null) {
        try {
          final info = await _api.getArtistInfo(yandexArtistId);
          final sim = info?['similarArtists'] as List?;
          if (sim != null) similar = sim.take(6).map((e) => e['name']?.toString() ?? '').where((e) => e.isNotEmpty).toList();
        } catch (_) {}
      }

      final meta = EnrichedMeta(genre: genre ?? yGenres.firstOrNull, yandexGenres: yGenres, similarArtists: similar);
      _memory[key] = meta;
      // Persist async without awaiting
      Future.microtask(_persist);
      return meta;
    } catch (e) {
      debugPrint('[Enrich] enrichSong error for ${song.title}: $e');
      return null;
    }
  }

  /// Batch enrich — enriches up to [limit] songs with missing genre, with throttle.
  Future<int> enrichBatch(List<Song> songs, {int limit = 40, Duration throttle = const Duration(milliseconds: 300)}) async {
    await _ensureLoaded();
    int enriched = 0;
    int attempted = 0;
    for (final s in songs) {
      if (s.genre != null && s.genre!.isNotEmpty) continue; // already has genre
      if (getCachedForSong(s) != null) continue;
      if (attempted >= limit) break;
      attempted++;
      final m = await enrichSong(s);
      if (m?.genre != null) enriched++;
      if (throttle.inMilliseconds > 0) await Future.delayed(throttle);
    }
    debugPrint('[Enrich] batch: attempted $attempted, enriched $enriched');
    return enriched;
  }

  /// Get effective genre for a song (local genre -> enriched -> first yandex genre)
  String? effectiveGenre(Song s) {
    if (s.genre != null && s.genre!.isNotEmpty) return s.genre;
    final c = getCachedForSong(s);
    if (c?.genre != null) return c!.genre;
    if (c != null && c.yandexGenres.isNotEmpty) return c.yandexGenres.first;
    // Try artist cache
    if (s.artist != null) {
      final ac = getCachedForArtist(s.artist!);
      if (ac?.genre != null) return ac!.genre;
      if (ac != null && ac.yandexGenres.isNotEmpty) return ac.yandexGenres.first;
    }
    return null;
  }

  /// Cache stats for settings UI
  int get cachedCount => _memory.length;
  int get songEntries => _memory.keys.where((k) => !k.startsWith('artist::')).length;
  int get artistEntries => _memory.keys.where((k) => k.startsWith('artist::')).length;

  Map<String, int> genreHistogram() {
    final map = <String, int>{};
    for (final m in _memory.values) {
      final g = m.genre ?? (m.yandexGenres.isNotEmpty ? m.yandexGenres.first : null);
      if (g != null) map[g] = (map[g] ?? 0) + 1;
    }
    return map;
  }

  double coverageFor(List<Song> songs) {
    if (songs.isEmpty) return 0;
    int withGenre = 0;
    for (final s in songs) {
      if (effectiveGenre(s) != null) withGenre++;
    }
    return withGenre / songs.length;
  }

  /// Clear cache.
  Future<void> clear() async {
    _memory.clear();
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove(_kCacheKey);
  }
}

extension _FirstOrNull<E> on List<E> {
  E? get firstOrNull => isEmpty ? null : first;
}
